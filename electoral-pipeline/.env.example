DATABASE_URL=postgresql+psycopg://electoral:electoral@db:5432/electoral
REDIS_URL=redis://redis:6379/0
DOCUMENT_ROOT=/data/pdfs
PDF_SOURCE_PATH=./sample-pdfs
MAX_UPLOAD_FILE_MB=100
MAX_UPLOAD_BATCH_MB=2000
MAX_UPLOAD_FILES=500
MINIO_ENABLED=false
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=electoral-minio-admin
MINIO_ROOT_PASSWORD=electoral-minio-local-2026
MINIO_ACCESS_KEY=electoral-minio-admin
MINIO_SECRET_KEY=electoral-minio-local-2026
MINIO_BUCKET=electoral-archives
MINIO_PREFIX=
MINIO_REGION=us-east-1
MINIO_DATA_PATH=./minio-data
MINIO_CONSOLE_PUBLIC_URL=http://192.168.0.15:9001
MINIO_DELETE_AFTER_INGEST=false
MINIO_MAX_ARCHIVE_MB=2048
MINIO_MAX_EXTRACTED_MB=5000
EXTRACTOR_MODE=http
EXTRACTOR_URL=http://ocr:8082/ocr/extract
EXTRACTOR_API_KEY=
EXTRACTOR_TIMEOUT_SECONDS=120
# --- two OCR readers, chosen per PDF ---------------------------------------
# EXTRACTOR_URL above is the image-scanned reader. TEXT_EXTRACTOR_URL is the
# born-digital reader, for rolls that ship with a text layer. The two do not
# overlap: each returns 422 on the other's PDFs, so every file is classified
# before it is sent (app/extractor.py::_resolve_ocr_url).
#
# SCANNED_EXTRACTOR_URL exists so the scanned reader can be repointed without
# editing EXTRACTOR_URL, which other things also read. Leave it unset to mean
# "the same as EXTRACTOR_URL".
#
# OCR_ROUTER=off sends everything to the scanned reader, which is the old
# single-service behaviour.
TEXT_EXTRACTOR_URL=http://ocr-text:8083/ocr/extract
SCANNED_EXTRACTOR_URL=
OCR_ROUTER=on
EXTRACTION_SCHEMA_VERSION=electoral_v1
PAGES_PER_UNIT=10
MAX_UNIT_ATTEMPTS=3
UNIT_STALE_SECONDS=600
DOCUMENT_STALE_SECONDS=600
RETRY_BASE_SECONDS=30
ADMIN_TOKEN=electoral-local-2026
WEB_PORT=8088