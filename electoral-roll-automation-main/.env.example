# ECI Electoral Roll Downloader environment
# Copy to .env and fill in. Defaults mirror electoral-pipeline/app/config.py so
# an unattended run lands in the bucket the pipeline polls; supply the real
# values from your own electoral-pipeline/.env rather than committing them.

# NVIDIA Vision API key for captcha solving (https://ngc.nvidia.com/)
VISION_API_KEY=your_nvidia_api_key_here

# MinIO — names default to the pipeline's, so only the credentials are needed.
# Endpoint may include a scheme or not; both are accepted.
# On the host, use localhost:9000. Inside the compose network, minio:9000.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=electoral-archives
MINIO_PREFIX=
# Defaults to whether MINIO_ENDPOINT is https://
# MINIO_SECURE=false

# Optional: Python path for development
# PYTHONPATH=./src