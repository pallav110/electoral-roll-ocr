DATABASE_URL=postgresql+psycopg://electoral:electoral@db:5432/electoral
REDIS_URL=redis://redis:6379/0
DOCUMENT_ROOT=/data/pdfs
EXTRACTOR_MODE=http
# OCR PDF API service endpoint (internal Docker service)
EXTRACTOR_URL=http://ocr:8082/ocr/extract
# Shared secret the web app sends to the OCR service, and that the OCR service
# requires on /ocr/extract. Both sides read the same value. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The OCR service refuses to start if this is empty, so a half-configured
# deployment fails at boot rather than silently serving an open endpoint.
EXTRACTOR_API_KEY=
EXTRACTOR_TIMEOUT_SECONDS=120
EXTRACTION_SCHEMA_VERSION=electoral_v1
PAGES_PER_UNIT=10
MAX_UNIT_ATTEMPTS=3
UNIT_STALE_SECONDS=600
DOCUMENT_STALE_SECONDS=600
RETRY_BASE_SECONDS=30
# Admin credential for every route except /health. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# There is intentionally no working default -- the app refuses to start if this
# is unset or left as the published placeholder. Do not commit a real value;
# .env is gitignored and excluded from the build context and the team ZIP.
ADMIN_TOKEN=
WEB_PORT=8088
