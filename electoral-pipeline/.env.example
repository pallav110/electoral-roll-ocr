DATABASE_URL=postgresql+psycopg://electoral:electoral@db:5432/electoral
REDIS_URL=redis://redis:6379/0
DOCUMENT_ROOT=/data/pdfs
EXTRACTOR_MODE=http
# OCR PDF API service endpoint (internal Docker service)
EXTRACTOR_URL=http://ocr:8082/ocr/extract
EXTRACTOR_API_KEY=
EXTRACTOR_TIMEOUT_SECONDS=120
EXTRACTION_SCHEMA_VERSION=electoral_v1
PAGES_PER_UNIT=10
MAX_UNIT_ATTEMPTS=3
UNIT_STALE_SECONDS=600
DOCUMENT_STALE_SECONDS=600
RETRY_BASE_SECONDS=30
ADMIN_TOKEN=change-me-before-deployment
WEB_PORT=8088
