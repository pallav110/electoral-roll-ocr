FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-eng tesseract-ocr-hin \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir fastapi==0.115.12 "uvicorn[standard]==0.34.2" \
    python-multipart==0.0.20 PyMuPDF==1.25.5 pytesseract==0.3.13 \
    numpy==2.2.5 opencv-python-headless==4.11.0.86
COPY ocr_image_and_details_extractor.py /app/ocr_image_and_details_extractor.py
COPY map_georeference.py /app/map_georeference.py
CMD ["uvicorn", "ocr_image_and_details_extractor:app", "--host", "0.0.0.0", "--port", "8084"]
